# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Express "trust proxy" setting — REQUIRED to be set correctly whenever this
# runs behind a reverse proxy/load balancer, or the per-IP login rate
# limiter either shares one bucket across every user or becomes spoofable.
# Leave as false for local dev. In production set to the exact hop count
# (e.g. "1" for a single reverse proxy in front of this process) or a
# trusted IP/CIDR list. See https://expressjs.com/en/guide/behind-proxies.html
TRUST_PROXY=false

# Database (MySQL, used by Prisma)
DATABASE_URL="mysql://user:password@localhost:3306/assetsouq"

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# Bootstrap admin (used only by `npm run prisma:seed`; leave unset to skip
# seeding and create the first admin some other way instead)
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# Mail (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AssetSouq <no-reply@example.com>"
