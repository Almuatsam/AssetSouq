# E2E test environment — a dedicated database and admin account, kept
# entirely separate from local dev data (see README.md's "Database (local
# dev)" section for the shared MySQL container both point at).
#
# Copy to .env.e2e.local and fill in real values; that file is gitignored
# (matches the repo's existing .env.*.local pattern).

# Same MySQL container as local dev (docker-compose.yml), different
# database name/credentials pair so global-setup.ts can freely reset it
# without touching assetsouq_dev.
DATABASE_URL="mysql://assetsouq:password@localhost:3308/assetsouq_e2e"

# Standalone secret for the E2E backend instance — never reuse a real
# dev/prod JWT_SECRET here.
JWT_SECRET=e2e-only-secret-do-not-use-elsewhere

# Bootstrap admin global-setup.ts seeds fresh before every run.
SEED_ADMIN_USERNAME=e2e_admin
SEED_ADMIN_PASSWORD=change-me-to-a-strong-test-only-password

# Ports the backend/frontend E2E instances run on — deliberately different
# from the normal dev ports (4000/5173) so `npm run test:e2e` can run
# alongside an already-running dev environment without a port clash.
BACKEND_PORT=4001
FRONTEND_PORT=5174
