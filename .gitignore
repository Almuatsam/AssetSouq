# Dependencies
node_modules/

# Env files (never commit real secrets) — every .env* is ignored except
# the .env*.example files that document required variables. (Broadened
# from just .env/.env.local/.env.*.local — those three missed
# .env.production, added for docker-compose.prod.yml, entirely.)
.env*
!.env.example
!backend/.env.example
!frontend/.env.example
!e2e/.env.e2e.example
!.env.production.example

# Build output
dist/
build/
*.tsbuildinfo

# tsc -b output for frontend/tsconfig.node.json (composite:true requires
# emit, so these land next to vite.config.ts even though nothing consumes
# them — Vite loads vite.config.ts directly, not this compiled output)
frontend/vite.config.js
frontend/vite.config.d.ts

# Prisma
backend/prisma/migrations/dev.db
backend/generated/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test coverage
coverage/

# Playwright (e2e/)
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/

# Claude Code harness-internal state
.claude/
