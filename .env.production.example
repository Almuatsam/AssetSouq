# Production environment for docker-compose.prod.yml — a self-hosted
# Caddy -> frontend (nginx) -> backend -> MySQL stack. NOT used for local
# dev (see backend/.env.example, frontend/.env.example, and the root
# .env.example for docker-compose.yml's dev-only MySQL container).
#
# Copy to .env.production, fill in real values, never commit it (see
# .gitignore). Usage:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d
#
# See docs/07-Deployment.md for the full deployment guide.

# --- Domain (Caddy) ---
# A real, publicly-resolvable domain — Caddy requests a Let's Encrypt
# certificate for whatever this is set to, which requires ports 80/443
# to be reachable from the internet for the ACME HTTP challenge. Using a
# bare IP or "localhost" here gets you a self-signed cert instead (fine
# for a private/internal deployment, but browsers will warn).
DOMAIN=assetsouq.example.com

# --- MySQL ---
# Generate real random values for these two — e.g. `openssl rand -base64 24`.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=assetsouq
MYSQL_USER=assetsouq
MYSQL_PASSWORD=

# --- Backend ---
PORT=4000
NODE_ENV=production

# Must match the MYSQL_* values above exactly (host is "mysql" — the
# Docker Compose service name, resolved via Docker's embedded DNS, not
# localhost).
DATABASE_URL="mysql://assetsouq:CHANGE_ME@mysql:3306/assetsouq"

# Two reverse-proxy hops sit in front of the backend in this stack —
# Caddy, then the frontend container's nginx (see frontend/nginx.conf) —
# both of which correctly forward/extend X-Forwarded-For. Set this to
# the hop count, not `true`: an incorrect value here either collapses
# every visitor into one rate-limit bucket (too low) or lets a client
# spoof their own X-Forwarded-For to bypass rate limiting entirely (too
# high) — see backend/src/config/env.ts's TRUST_PROXY comment and
# https://expressjs.com/en/guide/behind-proxies.html.
TRUST_PROXY=2

# Generate a real random secret — e.g. `openssl rand -base64 48`. Never
# reuse the dev secret from backend/.env.example.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# CORS_ORIGIN is intentionally NOT set here — frontend/nginx.conf reverse
# -proxies /api same-origin, so the browser only ever talks to one
# origin (the DOMAIN above) and no cross-origin request — and therefore
# no CORS configuration — is ever involved. Only set CORS_ORIGIN if this
# backend is ever deployed separately from that nginx.conf.

# Bootstrap admin — used once by `prisma migrate deploy`'s configured
# seed (see backend/package.json's "prisma.seed"). Leave unset after the
# first deploy's initial migration to skip re-seeding; rotate this
# password immediately after first login regardless.
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# --- Mail (Nodemailer) — optional, unused by any feature yet ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AssetSouq <no-reply@example.com>"
